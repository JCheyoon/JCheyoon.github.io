---
// 글 페이지(SPEC §6, §7). 본문은 빌드 HTML에 들어가고, BlogPosting·BreadcrumbList JSON-LD를 넣는다.
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../site.config";
import { getCategory } from "../../data/categories";
import { formatDate, getVisiblePosts, isoDate, postDate, postUrl, type Post } from "../../lib/posts";

export const getStaticPaths = (async () => {
  const posts = await getVisiblePosts();
  // posts는 최신순이다. newer = 바로 다음에 나온 글, older = 바로 앞에 나온 글.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { data } = post;
const { Content } = await render(post);

const category = getCategory(data.category);
const published = postDate(post);
const isDraft = data.status !== "published";
const pageUrl = new URL(postUrl(post), site.url).href;
const ogImage = data.cover ? data.cover.src.src : site.defaultOgImage;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: data.title,
    description: data.description,
    datePublished: published.toISOString(),
    dateModified: (data.updated_at ?? published).toISOString(),
    author: { "@type": "Person", name: site.author.name },
    image: new URL(ogImage, site.url).href,
    mainEntityOfPage: pageUrl,
    inLanguage: "ko",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: site.name, item: new URL("/", site.url).href },
      ...(category
        ? [{ "@type": "ListItem", position: 2, name: category.name, item: new URL(`/category/${category.slug}/`, site.url).href }]
        : []),
      { "@type": "ListItem", position: category ? 3 : 2, name: data.title, item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  image={ogImage}
  publishedTime={published}
  modifiedTime={data.updated_at}
  noindex={isDraft}
  jsonLd={jsonLd}
>
  <article class="max-w-3xl">
    {
      isDraft && (
        <p class="mb-6 rounded-xl border border-dashed px-4 py-3 text-sm text-muted-foreground">
          초안 미리보기입니다(status: {data.status}). 배포 빌드에는 포함되지 않습니다.
        </p>
      )
    }

    <nav aria-label="현재 위치" class="mb-4 text-xs text-muted-foreground">
      <a href="/" class="hover:text-foreground">홈</a>
      {
        category && (
          <>
            <span aria-hidden="true"> / </span>
            <a href={`/category/${category.slug}/`} class="hover:text-foreground">
              {category.name}
            </a>
          </>
        )
      }
    </nav>

    <header class="space-y-3">
      <h1 class="text-3xl font-bold leading-tight">{data.title}</h1>
      <p class="text-sm text-muted-foreground">
        {site.author.name} · <time datetime={isoDate(published)}>{formatDate(published)}</time>
        {
          data.updated_at && (
            <>
              {" · 수정 "}
              <time datetime={isoDate(data.updated_at)}>{formatDate(data.updated_at)}</time>
            </>
          )
        }
      </p>
    </header>

    {
      data.disclosure && (
        <p class="mt-5 rounded-xl border-2 border-accent-bar bg-card px-4 py-3 text-sm font-semibold" role="note">
          {data.disclosure}
        </p>
      )
    }

    {
      data.cover && (
        <Image src={data.cover.src} alt={data.cover.alt} class="mt-6 w-full rounded-2xl" loading="eager" />
      )
    }

    <hr class="my-6" />

    <div class="prose prose-slate max-w-none dark:prose-invert">
      <Content />
    </div>

    {
      data.sources.length > 0 && (
        <section class="mt-10" aria-labelledby="sources-heading">
          <h2 id="sources-heading" class="text-lg font-semibold">
            참고한 자료
          </h2>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-sm">
            {data.sources.map((s) => (
              <li>
                <a href={s.url} rel="noopener" class="underline underline-offset-4">
                  {s.title}
                </a>
                <span class="text-muted-foreground"> ({formatDate(s.accessed)} 확인)</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      data.tags.length > 0 && (
        <ul class="mt-8 flex flex-wrap gap-2" aria-label="태그">
          {data.tags.map((tag) => (
            <li class="rounded-full bg-muted px-3 py-1 text-xs text-muted-foreground">#{tag}</li>
          ))}
        </ul>
      )
    }

    {
      (newer || older) && (
        <nav aria-label="이전 글과 다음 글" class="mt-10 grid gap-3 border-t pt-6 text-sm sm:grid-cols-2">
          {older ? (
            <a href={postUrl(older)} rel="prev" class="rounded-xl bg-card px-4 py-3 hover:shadow">
              <span class="block text-xs text-muted-foreground">이전 글</span>
              {older.data.title}
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a href={postUrl(newer)} rel="next" class="rounded-xl bg-card px-4 py-3 text-right hover:shadow">
              <span class="block text-xs text-muted-foreground">다음 글</span>
              {newer.data.title}
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>
