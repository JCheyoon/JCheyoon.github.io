---
// 목록 페이지네이션(SPEC §6). 모든 이동은 링크다. 1페이지뿐이면 아무것도 그리지 않는다.
// - 데스크톱(640px 이상): 연속 번호 5개 + 처음·끝 + …(참고 블로그 방식). 빠지는 번호가 1개뿐이면 …대신 그 번호
// - 모바일: ‹ 4 / 8 › 한 줄
// 이전·다음은 갈 곳이 없어도 자리를 지킨다(번호 위치가 흔들리지 않게). 그때는 링크가 아닌 흐린 장식이다.
import Icon from "./Icon.astro";
import { pagedUrl } from "../lib/posts";
import { localizePath, ui, type Lang } from "../i18n";

interface Props {
  current: number;
  total: number;
  lang: Lang;
  /** 1페이지 주소(예: /, /category/etc/, /en/tag/astro/). 생략하면 그 언어의 홈 */
  base?: string;
}

const { current, total, lang, base = localizePath(lang, "/") } = Astro.props;
const t = ui[lang];
const urlFor = (page: number) => pagedUrl(base, page);

// 현재 페이지에서 시작해 양쪽으로 번갈아 넓히고, 한쪽 끝에 닿으면 다른 쪽으로 채워 5개를 만든다
const VISIBLE = 5;
let l = current;
let r = current;
while (r - l + 1 < VISIBLE && (l > 1 || r < total)) {
  if (l > 1) l--;
  if (r - l + 1 < VISIBLE && r < total) r++;
}
const pages: (number | "gap")[] = [];
if (l > 1) pages.push(1);
if (l === 3) pages.push(2);
if (l > 3) pages.push("gap");
for (let p = l; p <= r; p++) pages.push(p);
if (r === total - 2) pages.push(total - 1);
if (r < total - 2) pages.push("gap");
if (r < total) pages.push(total);

const square = "flex h-11 w-11 items-center justify-center rounded-lg";
const arrow = `${square} bg-card text-accent-bar transition hover:bg-muted active:scale-90`;
const arrowOff = `${square} bg-card text-accent-bar opacity-40`;
---

{
  total > 1 && (
    <nav aria-label={t.pagination} class="mt-8 flex items-center justify-center gap-3">
      {current > 1 ? (
        <a href={urlFor(current - 1)} rel="prev" aria-label={t.prev} class={arrow}>
          <Icon name="chevron-left" class="h-6 w-6" />
        </a>
      ) : (
        <span class={arrowOff} aria-hidden="true">
          <Icon name="chevron-left" class="h-6 w-6" />
        </span>
      )}

      <div class="hidden items-center rounded-lg bg-card font-bold sm:flex">
        {pages.map((p) =>
          p === "gap" ? (
            <span class="flex h-11 w-6 items-center justify-center text-muted-foreground" aria-hidden="true">
              …
            </span>
          ) : p === current ? (
            <span aria-current="page" class={`${square} bg-logo text-xl text-on-logo`}>
              {p}
            </span>
          ) : (
            <a href={urlFor(p)} class={`${square} transition hover:bg-muted active:scale-90`}>
              {p}
            </a>
          ),
        )}
      </div>

      <p class="flex h-11 items-center rounded-lg bg-card px-4 font-bold tabular-nums sm:hidden">
        <span aria-current="page">{current}</span>
        <span class="mx-1.5 text-muted-foreground">/</span>
        <span class="text-muted-foreground">{total}</span>
      </p>

      {current < total ? (
        <a href={urlFor(current + 1)} rel="next" aria-label={t.next} class={arrow}>
          <Icon name="chevron-right" class="h-6 w-6" />
        </a>
      ) : (
        <span class={arrowOff} aria-hidden="true">
          <Icon name="chevron-right" class="h-6 w-6" />
        </span>
      )}
    </nav>
  )
}
