---
// 글 페이지(SPEC §6, §7). 한국어는 /post/<slug>/, 영어는 /en/post/<slug>/.
// 본문은 빌드 HTML에 들어가고, BlogPosting·BreadcrumbList JSON-LD를 넣는다.
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { site } from "../../../site.config";
import { categoryName, categoryUrl, getCategory } from "../../../data/categories";
import { formatDate, getVisiblePosts, isoDate, postDate, postUrl, type Post } from "../../../lib/posts";
import { langPaths, localizePath, ui } from "../../../i18n";

export const getStaticPaths = (async () => {
  const perLang = await Promise.all(
    langPaths.map(async ({ params }) => {
      const posts = await getVisiblePosts(params.lang ?? "ko");
      // posts는 최신순이다. newer = 바로 다음에 나온 글, older = 바로 앞에 나온 글. 같은 언어 안에서만 잇는다.
      return posts.map((post, i) => ({
        params: { ...params, slug: post.data.slug },
        props: { post, newer: posts[i - 1], older: posts[i + 1] },
      }));
    }),
  );
  return perLang.flat();
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { data } = post;
const lang = data.lang;
const t = ui[lang];
const { Content } = await render(post);

const category = getCategory(data.category);
const published = postDate(post);
const isDraft = data.status !== "published";
const pageUrl = new URL(postUrl(post), site.url).href;
const ogImage = data.cover ? data.cover.src.src : site.defaultOgImage;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: data.title,
    description: data.description,
    datePublished: published.toISOString(),
    dateModified: (data.updated_at ?? published).toISOString(),
    author: { "@type": "Person", name: site.author.name },
    image: new URL(ogImage, site.url).href,
    mainEntityOfPage: pageUrl,
    inLanguage: lang,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: site.name, item: new URL(localizePath(lang, "/"), site.url).href },
      ...(category
        ? [{ "@type": "ListItem", position: 2, name: categoryName(category, lang), item: new URL(categoryUrl(category.slug, lang), site.url).href }]
        : []),
      { "@type": "ListItem", position: category ? 3 : 2, name: data.title, item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  image={ogImage}
  publishedTime={published}
  modifiedTime={data.updated_at}
  noindex={isDraft}
  jsonLd={jsonLd}
  lang={lang}
>
  <article class="max-w-3xl">
    {
      isDraft && (
        <p class="mb-6 rounded-xl border border-dashed px-4 py-3 text-sm text-muted-foreground">
          {t.draftNotice(data.status)}
        </p>
      )
    }

    <nav aria-label={t.breadcrumb} class="mb-4 text-xs text-muted-foreground">
      <a href={localizePath(lang, "/")} class="hover:text-foreground">{t.home}</a>
      {
        category && (
          <>
            <span aria-hidden="true"> / </span>
            <a href={categoryUrl(category.slug, lang)} class="hover:text-foreground">
              {categoryName(category, lang)}
            </a>
          </>
        )
      }
    </nav>

    <header class="space-y-3">
      <h1 class="text-3xl font-bold leading-tight">{data.title}</h1>
      <p class="text-sm text-muted-foreground">
        {site.author.name} · <time datetime={isoDate(published)}>{formatDate(published, lang)}</time>
        {
          data.updated_at && (
            <>
              {` · ${t.updated} `}
              <time datetime={isoDate(data.updated_at)}>{formatDate(data.updated_at, lang)}</time>
            </>
          )
        }
      </p>
    </header>

    {
      data.disclosure && (
        <p class="mt-5 rounded-xl border-2 border-accent-bar bg-card px-4 py-3 text-sm font-semibold" role="note">
          {data.disclosure}
        </p>
      )
    }

    {
      data.cover && (
        <Image src={data.cover.src} alt={data.cover.alt} class="mt-6 w-full rounded-2xl" loading="eager" />
      )
    }

    <hr class="my-6" />

    <div class="prose prose-slate max-w-none dark:prose-invert">
      <Content />
    </div>

    {
      data.sources.length > 0 && (
        <section class="mt-10" aria-labelledby="sources-heading">
          <h2 id="sources-heading" class="text-lg font-semibold">
            {t.sources}
          </h2>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-sm">
            {data.sources.map((s) => (
              <li>
                <a href={s.url} rel="noopener" class="underline underline-offset-4">
                  {s.title}
                </a>
                <span class="text-muted-foreground"> ({t.accessed(formatDate(s.accessed, lang))})</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      data.tags.length > 0 && (
        <ul class="mt-8 flex flex-wrap gap-2" aria-label={t.tags}>
          {data.tags.map((tag) => (
            <li class="rounded-full bg-muted px-3 py-1 text-xs text-muted-foreground">#{tag}</li>
          ))}
        </ul>
      )
    }

    {
      (newer || older) && (
        <nav aria-label={t.prevNextNav} class="mt-10 grid gap-3 border-t pt-6 text-sm sm:grid-cols-2">
          {older ? (
            <a href={postUrl(older)} rel="prev" class="rounded-xl bg-card px-4 py-3 hover:shadow">
              <span class="block text-xs text-muted-foreground">{t.prevPost}</span>
              {older.data.title}
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a href={postUrl(newer)} rel="next" class="rounded-xl bg-card px-4 py-3 text-right hover:shadow">
              <span class="block text-xs text-muted-foreground">{t.nextPost}</span>
              {newer.data.title}
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>
