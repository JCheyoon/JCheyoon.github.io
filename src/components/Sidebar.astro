---
// 프로필과 카테고리. 글이 없는 카테고리는 페이지가 없으므로 목록에 넣지 않는다(죽은 링크 방지).
import { site } from "../site.config";
import { categories, categoryName, categoryUrl } from "../data/categories";
import { filterByCategory, tagCounts, tagUrl, type Post } from "../lib/posts";
import { localizePath, ui, type Lang } from "../i18n";
import CategoryLink from "./CategoryLink.astro";
import Icon from "./Icon.astro";

interface Props {
  posts: Post[];
  lang: Lang;
}

const { posts, lang } = Astro.props;
const t = ui[lang];
const path = Astro.url.pathname;
const home = localizePath(lang, "/");
const tags = tagCounts(posts);
const listed = categories
  .map((c) => ({ ...c, count: filterByCategory(posts, c.slug).length }))
  .filter((c) => c.count > 0);

// 맨 위는 전체 글(= 홈 목록). 카테고리 페이지에서 전체로 돌아갈 수 있게 한다.
// 페이지를 나눈 카테고리(/category/x/page/2/)에서도 활성으로 보이게 주소 앞부분으로 비교한다.
const categoryItems = [
  { href: home, name: t.allPosts, count: posts.length, active: path === home || path.startsWith(localizePath(lang, "/page/")) },
  ...listed.map((c) => {
    const href = categoryUrl(c.slug, lang);
    return { href, name: categoryName(c, lang), count: c.count, active: path.startsWith(href) };
  }),
];
// 전체 글 + 카테고리 6개까지 보이고, 나머지는 "더보기"로 접는다
const SHOWN = 7;
const shownCategories = categoryItems.slice(0, SHOWN);
const moreCategories = categoryItems.slice(SHOWN);

---

<aside class="flex flex-col gap-6" aria-label={t.sidebar}>
  <section class="rounded-2xl border bg-card px-5 py-5 text-center">
    <p class="mt-1 text-sm font-semibold">WELCOME</p>
    <span class="mx-auto mt-2 mb-2.5 block h-1 w-5 rounded-full bg-accent-bar" aria-hidden="true"></span>
    <p class="text-xs text-muted-foreground">{site.tagline[lang]}</p>
    <ul class="mt-4 flex justify-center gap-3">
      {
        site.social.map((s) => (
          <li>
            <a href={s.href} rel="me noopener" class="text-sm font-bold hover:underline">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    listed.length > 0 && (
      <nav class="rounded-2xl border bg-card px-3 py-4" aria-label={t.categories}>
        <h2 class="mb-3 px-2 text-base font-semibold text-muted-foreground">{t.categories}</h2>
        <ul class="flex flex-col gap-1">
          {shownCategories.map((item) => (
            <li>
              <CategoryLink {...item} />
            </li>
          ))}
        </ul>
        {
          moreCategories.length > 0 && (
            // 카테고리가 많으면 나머지는 접어 둔다. 지금 보는 카테고리가 그 안에 있으면 펼친다
            <details open={moreCategories.some((c) => c.active)} class="group">
              <summary class="mt-1 cursor-pointer list-none rounded-lg px-3 py-2 text-sm text-muted-foreground hover:bg-background hover:text-foreground">
                <span class="group-open:hidden">{t.more(moreCategories.length)}</span>
                <span class="hidden group-open:inline">{t.less}</span>
              </summary>
              <ul class="mt-1 flex flex-col gap-1">
                {moreCategories.map((item) => (
                  <li>
                    <CategoryLink {...item} />
                  </li>
                ))}
              </ul>
            </details>
          )
        }
      </nav>
    )
  }
  {
    tags.length > 0 && (
      <nav class="rounded-2xl border bg-card px-3 py-4" aria-label={t.tags}>
        <h2 class="mb-3 px-2 text-base font-semibold text-muted-foreground">{t.tags}</h2>
        <ul class="flex flex-wrap gap-2 px-2">
          {tags.map(({ tag, count }) => {
            const href = tagUrl(tag, lang);
            const active = path.startsWith(href);
            // 선택된 태그를 다시 누르면 해제(전체 글로 이동). 카테고리의 "전체 글" 역할
            return (
              <li>
                <a
                  href={active ? home : href}
                  aria-label={active ? t.tagClear(tag) : `#${tag} (${count})`}
                  class:list={[
                    "flex items-center gap-1 rounded-lg px-2.5 py-1 text-sm transition",
                    active ? "bg-background font-semibold text-foreground" : "bg-background/60 text-muted-foreground hover:bg-background hover:text-foreground",
                  ]}
                >
                  {tag}
                  {active && <Icon name="close" class="h-3.5 w-3.5" />}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    )
  }
</aside>
