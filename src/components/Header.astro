---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../site.config";
import { localizePath, otherLang, ui, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  /** 언어 전환 링크 주소. 없으면 링크를 그리지 않는다. */
  switchHref?: string;
}

const { lang, switchHref } = Astro.props;
const target = ui[otherLang(lang)];
const t = ui[lang];
const home = localizePath(lang, "/");

// 문의는 Phase 4에서 추가한다(미구현 메뉴는 두지 않는다).
const links = [
  { href: home, label: t.home },
  { href: localizePath(lang, "/archive/"), label: t.archive },
  { href: localizePath(lang, "/about/"), label: t.about },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === home ? path === home || path.startsWith(localizePath(lang, "/page/")) : path.startsWith(href);
---

<header class="sticky top-0 z-10 border-b bg-card/90 backdrop-blur">
  {/* 로고 | 메뉴(가운데) | 오른쪽 빈 칸. 오른쪽 칸은 언어 전환(Phase 2)·테마 토글(Phase 3) 자리라 메뉴가 밀리지 않는다 */}
  <div class="mx-auto grid h-16 max-w-[1200px] grid-cols-[1fr_auto_1fr] items-center gap-4 px-4 md:px-6">
    <a href={home} class="flex items-center justify-self-start text-foreground" aria-label={`${site.name} ${t.home}`}>
      <Logo />
    </a>
    <nav aria-label={t.mainMenu}>
      <ul class="flex items-center gap-2">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class:list={[
                  "inline-flex h-10 items-center rounded-lg px-4 text-sm font-medium",
                  isActive(link.href)
                    ? "bg-background text-foreground font-semibold"
                    : "text-muted-foreground hover:bg-background hover:text-foreground",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {/* 오른쪽 칸: 언어 전환(번역본이 있을 때) + 테마 토글 */}
    <div class="flex items-center gap-1 justify-self-end">
      {
        switchHref && (
          <a
            href={switchHref}
            hreflang={target.htmlLang}
            lang={target.htmlLang}
            aria-label={target.langSwitch}
            class="inline-flex h-10 items-center rounded-lg px-3 text-sm font-medium text-muted-foreground hover:bg-background hover:text-foreground"
          >
            {target.langName}
          </a>
        )
      }
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>
