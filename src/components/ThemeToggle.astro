---
// 테마 토글(D14, SPEC §8). 라이트/다크 2단계. 처음엔 시스템 설정을 따르고, 누르면 반대로 바꿔 저장한다.
// 스크립트가 없으면 시스템 설정을 따르고 버튼은 숨긴다(동작하지 않는 UI를 두지 않는다).
import Icon from "./Icon.astro";
import { ui, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label={ui[lang].themeToggle}
  class="theme-toggle hidden h-10 w-10 items-center justify-center rounded-lg text-muted-foreground transition hover:bg-background hover:text-foreground"
>
  {/* 아이콘은 하나만 보인다. 지금 라이트면 달(누르면 다크), 다크면 해(누르면 라이트) */}
  <span class="theme-icon-moon"><Icon name="moon" class="h-5 w-5" /></span>
  <span class="theme-icon-sun"><Icon name="sun" class="h-5 w-5" /></span>
</button>

<style>
  :global(.js) .theme-toggle {
    display: flex;
  }
  :global([data-theme="dark"]) .theme-icon-moon,
  :global([data-theme="light"]) .theme-icon-sun {
    display: none;
  }
</style>

<script>
  const root = document.documentElement;
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    button.addEventListener("click", () => {
      const next = root.dataset.theme === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {}
    });
  }
</script>
