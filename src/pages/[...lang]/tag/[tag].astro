---
// 태그 글 목록 1페이지(SPEC §4, D13). 글이 있는 태그만 만든다. 2페이지부터는 [tag]/page/[page].astro
import type { GetStaticPaths } from "astro";
import FilteredListPage from "../../../components/FilteredListPage.astro";
import { site } from "../../../site.config";
import { tagPages } from "../../../lib/list-pages";
import { ui } from "../../../i18n";

export const getStaticPaths = (async () => (await tagPages()).filter((p) => p.props.page === 1)) satisfies GetStaticPaths;

const { lang, name, posts, page, base, alternate, tag } = Astro.props;
---

<FilteredListPage
  lang={lang}
  name={name}
  description={ui[lang].tagDescription(site.name, tag, posts.length)}
  posts={posts}
  page={page}
  base={base}
  alternate={alternate}
/>
