---
// 카테고리 글 목록 1페이지(SPEC §4). 글이 있는 카테고리만 만든다(빈 페이지는 색인 가치가 없다).
// 언어마다 그 언어의 글로 따로 센다. 2페이지부터는 [slug]/page/[page].astro
import type { GetStaticPaths } from "astro";
import FilteredListPage from "../../../components/FilteredListPage.astro";
import { site } from "../../../site.config";
import { categoryPages } from "../../../lib/list-pages";
import { ui } from "../../../i18n";

export const getStaticPaths = (async () => (await categoryPages()).filter((p) => p.props.page === 1)) satisfies GetStaticPaths;

const { lang, name, posts, page, base, alternate } = Astro.props;
---

<FilteredListPage
  lang={lang}
  name={name}
  description={ui[lang].categoryDescription(site.name, name, posts.length)}
  posts={posts}
  page={page}
  base={base}
  alternate={alternate}
/>
