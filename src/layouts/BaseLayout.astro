---
import "../styles/global.css";
import SeoHead from "../components/SeoHead.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import { getVisiblePosts } from "../lib/posts";
import { localizePath, otherLang, ui } from "../i18n";
import type { Props as SeoProps } from "../components/SeoHead.astro";

type Props = Omit<SeoProps, "alternate"> & {
  /** false면 사이드바 없이 본문만 넓게 쓴다(404 등) */
  sidebar?: boolean;
  /**
   * 다른 언어의 같은 페이지 주소.
   * - 주소: hreflang을 넣고, 언어 전환 링크가 그 페이지로 간다.
   * - 생략: 같은 페이지가 없다. 전환 링크는 다른 언어 홈으로 간다(목록, 카테고리 등).
   * - null: 전환 링크를 숨긴다(번역본이 없는 글).
   */
  alternate?: string | null;
};

const { sidebar = true, alternate, ...seo } = Astro.props;
const lang = seo.lang ?? "ko";
const switchHref = alternate === null ? undefined : (alternate ?? localizePath(otherLang(lang), "/"));
const t = ui[lang];
const posts = sidebar ? await getVisiblePosts(lang) : [];
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <SeoHead {...seo} alternate={alternate ?? undefined} />
    {/*
      그리기 전에 실행한다(첫 화면 깜빡임 방지, SPEC §8).
      - js: 스크립트 없이도 동작하는 요소(맨 위로 버튼)가 이 값을 보고 모양을 바꾼다
      - data-theme: 저장된 테마(D14), 없으면 시스템 설정. 저장소를 못 쓰는 환경에서도 실패하지 않게 감싼다
    */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        let saved = null;
        try {
          saved = localStorage.getItem("theme");
        } catch {}
        root.dataset.theme =
          saved === "light" || saved === "dark" ? saved : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-20 focus:rounded focus:bg-card focus:px-3 focus:py-2"
      >{t.skipToContent}</a
    >
    <Header lang={lang} switchHref={switchHref} />
    <div
      class:list={[
        "mx-auto max-w-[1200px] px-4 py-6 md:px-6",
        sidebar && "grid gap-6 md:grid-cols-[17rem_minmax(0,1fr)]",
      ]}
    >
      {/* 모바일에서는 본문이 먼저, 사이드바가 아래에 온다 */}
      <main id="main" class:list={["relative min-w-0", sidebar && "md:order-2"]}>
        <slot />
        {/*
          본문 오른쪽 기둥(SPEC §6.1): 위에는 목차, 아래에는 맨 위로 버튼.
          본문과 같은 높이라서 목차는 본문 윗선에서 시작하고, 버튼은 끝에서 본문 아랫선(이전·다음 글 버튼)에 맞춰 멈춘다.
          본문 옆 여백이 좁으면(1424px 미만) 숨기고, 버튼은 화면 오른쪽 아래에 띄운다. 목차는 1536px 이상에서만 보인다.
        */}
        <div class="absolute top-0 bottom-0 left-full ml-4 hidden w-[min(16rem,calc((100vw-1200px)/2-1rem))] flex-col justify-between min-[1424px]:flex">
          {
            Astro.slots.has("toc") ? (
              <div class="sticky top-20 hidden max-h-[calc(100vh-11rem)] overflow-y-auto 2xl:block">
                <slot name="toc" />
              </div>
            ) : (
              <div />
            )
          }
          <div class="sticky bottom-6">
            <BackToTop lang={lang} variant="rail" />
          </div>
        </div>
      </main>
      {
        sidebar && (
          <div class="md:order-1">
            <Sidebar posts={posts} lang={lang} />
          </div>
        )
      }
    </div>
    <Footer />
    <BackToTop lang={lang} variant="floating" />
  </body>
</html>
