---
import Logo from "./Logo.astro";
import { site } from "../site.config";

// Phase 1 메뉴. 아카이브는 Phase 2, 문의는 Phase 3에서 추가한다(미구현 메뉴는 두지 않는다).
const links = [
  { href: "/", label: "홈" },
  { href: "/about/", label: "소개" },
];

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" || path.startsWith("/page/") : path.startsWith(href));
---

<header class="sticky top-0 z-10 border-b bg-card/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-[1200px] items-center justify-between gap-4 px-4 md:px-6">
    <a href="/" class="flex items-center text-foreground" aria-label={`${site.name} 홈`}>
      <Logo />
    </a>
    <nav aria-label="주 메뉴">
      <ul class="flex items-center gap-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class:list={[
                  "inline-flex h-10 items-center rounded-lg px-3 text-sm font-medium",
                  isActive(link.href)
                    ? "bg-background text-foreground font-semibold"
                    : "text-muted-foreground hover:text-foreground",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
