---
// 목록 페이지네이션(SPEC §6). 모든 이동은 링크다. 1페이지뿐이면 아무것도 그리지 않는다.
// 이전·다음 화살표 버튼과, 번호 묶음(현재 페이지는 채운 버튼). 페이지가 많으면 처음·끝·현재 주변만 보이고 나머지는 …로 줄인다.
// 갈 곳이 없는 이전·다음 버튼은 그리지 않는다(동작하지 않는 UI를 두지 않는다, project-scope).
import Icon from "./Icon.astro";
import { listPageUrl } from "../lib/posts";
import { ui, type Lang } from "../i18n";

interface Props {
  current: number;
  total: number;
  lang: Lang;
}

const { current, total, lang } = Astro.props;
const t = ui[lang];
const urlFor = (page: number) => listPageUrl(page, lang);

// 1, …, current-2..current+2, …, total
const shown = [...new Set([1, current - 2, current - 1, current, current + 1, current + 2, total])]
  .filter((p) => p >= 1 && p <= total)
  .sort((a, b) => a - b);
const pages: (number | "gap")[] = shown.flatMap((p, i) => (i > 0 && p - shown[i - 1] > 1 ? ["gap" as const, p] : [p]));

const arrow = "flex h-11 w-11 items-center justify-center rounded-lg bg-card text-accent-bar transition hover:bg-muted active:scale-90";
---

{
  total > 1 && (
    <nav aria-label={t.pagination} class="mt-8 flex flex-row items-center justify-center gap-3">
      {current > 1 && (
        <a href={urlFor(current - 1)} rel="prev" aria-label={t.prev} class={arrow}>
          <Icon name="chevron-left" class="h-6 w-6" />
        </a>
      )}
      <div class="flex flex-row items-center rounded-lg bg-card font-bold">
        {pages.map((p) =>
          p === "gap" ? (
            <span class="flex h-11 w-6 items-center justify-center text-muted-foreground" aria-hidden="true">
              …
            </span>
          ) : p === current ? (
            <span aria-current="page" class="flex h-11 w-11 items-center justify-center rounded-lg bg-logo text-xl text-on-logo">
              {p}
            </span>
          ) : (
            <a href={urlFor(p)} class="flex h-11 w-11 items-center justify-center rounded-lg transition hover:bg-muted active:scale-90">
              {p}
            </a>
          ),
        )}
      </div>
      {current < total && (
        <a href={urlFor(current + 1)} rel="next" aria-label={t.next} class={arrow}>
          <Icon name="chevron-right" class="h-6 w-6" />
        </a>
      )}
    </nav>
  )
}
