---
// 목록 1페이지. 한국어는 /, 영어는 /en/ (D11)
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ListHeader from "../../components/ListHeader.astro";
import PostList from "../../components/PostList.astro";
import Pagination from "../../components/Pagination.astro";
import { site } from "../../site.config";
import { getVisiblePosts, totalPages } from "../../lib/posts";
import { langPaths, localizePath, otherLang, ui } from "../../i18n";

export const getStaticPaths = (() => langPaths) satisfies GetStaticPaths;

const { lang } = Astro.props;
const posts = await getVisiblePosts(lang);
const pageCount = totalPages(posts.length, site.pageSize);
---

<BaseLayout title={site.name} description={site.description[lang]} isHome lang={lang} alternate={localizePath(otherLang(lang), "/")}>
  <ListHeader title={ui[lang].allPosts} count={posts.length} lang={lang} />
  <PostList posts={posts.slice(0, site.pageSize)} lang={lang} />
  <Pagination current={1} total={pageCount} lang={lang} />
</BaseLayout>
