---
// 목록 2페이지부터(SPEC §4: /page/[n]/, n ≥ 2). 1페이지는 홈(/)이다.
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import Pagination from "../../components/Pagination.astro";
import { site } from "../../site.config";
import { getVisiblePosts, totalPages } from "../../lib/posts";

export const getStaticPaths = (async () => {
  const posts = await getVisiblePosts();
  const pageCount = totalPages(posts.length, site.pageSize);
  return Array.from({ length: Math.max(0, pageCount - 1) }, (_, i) => {
    const page = i + 2;
    const start = (page - 1) * site.pageSize;
    return {
      params: { page: String(page) },
      props: { page, pageCount, posts: posts.slice(start, start + site.pageSize) },
    };
  });
}) satisfies GetStaticPaths;

const { page, pageCount, posts } = Astro.props;
---

<BaseLayout title={`글 목록 ${page}페이지`} description={`${site.name}의 글 목록 ${page}페이지입니다.`}>
  <h1 class="mb-6 text-sm text-muted-foreground">글 목록 {page}페이지</h1>
  <PostList posts={posts} />
  <Pagination current={page} total={pageCount} />
</BaseLayout>
