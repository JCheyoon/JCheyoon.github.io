---
// 사이드바 카테고리 한 줄(이름과 글 수). 활성이면 배경색
interface Props {
  href: string;
  name: string;
  count: number;
  active: boolean;
}

const { href, name, count, active } = Astro.props;
---

<a
  href={href}
  aria-current={active ? "page" : undefined}
  class:list={[
    "flex items-center justify-between rounded-lg px-3 py-2 text-sm",
    active ? "bg-background font-semibold text-foreground" : "text-muted-foreground hover:bg-background hover:text-foreground",
  ]}
>
  <span>{name}</span>
  <span class="text-xs">{count}</span>
</a>
