---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../site.config";
import { localizePath, otherLang, ui, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  /** 언어 전환 링크 주소. 없으면 링크를 그리지 않는다. */
  switchHref?: string;
  /** 768px 미만 글 페이지: 로고 대신 왼쪽 뒤로(‹) 링크를 보인다. label은 화면 읽기용(SPEC §6.2) */
  mobileBack?: { href: string; label: string };
}

const { lang, switchHref, mobileBack } = Astro.props;
const target = ui[otherLang(lang)];
const t = ui[lang];
const home = localizePath(lang, "/");

// 문의는 Phase 4에서 추가한다(미구현 메뉴는 두지 않는다).
const links = [
  { href: home, label: t.home },
  { href: localizePath(lang, "/archive/"), label: t.archive },
  { href: localizePath(lang, "/about/"), label: t.about },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === home ? path === home || path.startsWith(localizePath(lang, "/page/")) : path.startsWith(href);
---

<header class="site-header sticky top-0 z-10 border-b bg-card/90 backdrop-blur">
  {/* 로고 | 메뉴(가운데) | 오른쪽 빈 칸. 오른쪽 칸은 언어 전환(Phase 2)·테마 토글(Phase 3) 자리라 메뉴가 밀리지 않는다 */}
  {/* 640px 미만은 간격·여백을 줄이고 언어 링크를 EN/KO로 짧게 써서 360px 폰에서도 한 줄에 들어가게 한다 */}
  {/*
    768px 미만: 높이 48px, 양 끝 정렬(왼쪽 로고 또는 뒤로, 오른쪽 도구)
    768px 이상: 높이 64px, 3칸 그리드(로고 | 가운데 메뉴 | 도구). 메뉴가 숨는 모바일에서 그리드를 쓰면 도구가 가운데 칸으로 밀린다
  */}
  <div class="mx-auto flex h-12 max-w-[1200px] items-center justify-between gap-2 px-4 md:grid md:h-16 md:grid-cols-[1fr_auto_1fr] md:gap-4 md:px-6">
    <a
      href={home}
      class:list={["items-center justify-self-start text-foreground", mobileBack ? "hidden md:flex" : "flex"]}
      aria-label={`${site.name} ${t.home}`}
    >
      <Logo />
    </a>
    {
      mobileBack && (
        <a href={mobileBack.href} class="-ml-2 flex h-10 w-10 items-center justify-center justify-self-start rounded-lg text-foreground md:hidden" aria-label={`${t.back}: ${mobileBack.label}`}>
          <Icon name="chevron-left" class="h-6 w-6" />
        </a>
      )
    }
    {/* 768px 미만에서는 메뉴를 하단 탭 바(BottomTabs)로 옮기고 헤더에는 로고와 언어·테마만 둔다(SPEC §6.2) */}
    <nav aria-label={t.mainMenu} class="hidden md:block">
      <ul class="flex items-center sm:gap-2">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class:list={[
                  "inline-flex h-10 items-center rounded-lg px-3 text-sm font-medium lg:px-4",
                  isActive(link.href)
                    ? "bg-background text-foreground font-semibold"
                    : "text-muted-foreground hover:bg-background hover:text-foreground",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {/* 오른쪽 칸: 검색(768px 이상, 모바일은 하단 탭) + 언어 전환(번역본이 있을 때) + 테마 토글 */}
    <div class="flex items-center gap-1 justify-self-end">
      <button
        type="button"
        data-search-open
        aria-label={t.search}
        class="hidden h-10 min-w-10 items-center justify-center gap-2 rounded-lg border bg-background px-2.5 text-sm text-muted-foreground hover:text-foreground max-md:!hidden lg:px-3"
      >
        {/* 768~1023px는 메뉴와 함께 들어가도록 아이콘만, 1024px 이상은 글자와 단축키까지 */}
        <Icon name="search" class="h-4 w-4" />
        <span class="hidden lg:inline">{t.search}</span>
        <kbd class="hidden rounded-md border bg-card px-1.5 py-0.5 font-mono text-[0.7rem] lg:inline">⌘K</kbd>
      </button>
      {
        switchHref && (
          <a
            href={switchHref}
            hreflang={target.htmlLang}
            lang={target.htmlLang}
            aria-label={target.langSwitch}
            class="inline-flex h-10 items-center rounded-lg px-2 text-sm font-medium text-muted-foreground hover:bg-background hover:text-foreground sm:px-3"
          >
            <span class="sm:hidden">{target.langShort}</span>
            <span class="hidden sm:inline">{target.langName}</span>
          </a>
        )
      }
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>

<script>
  // 숨는 헤더(SPEC §6.2): 아래로 내리면 숨기고 위로 올리면 보인다. 숨기는 모양은 768px 미만에서만 적용된다(global.css)
  const header = document.querySelector<HTMLElement>(".site-header");
  let last = scrollY;
  addEventListener(
    "scroll",
    () => {
      const y = scrollY;
      header?.toggleAttribute("data-hidden", y > last && y > 64);
      last = y;
    },
    { passive: true },
  );
</script>
