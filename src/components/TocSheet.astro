---
// 목차 바텀 시트(SPEC §6.2, D15). 오른쪽 목차가 숨는 화면(1536px 미만)에서 쓴다.
// 왼쪽 아래 "목차" 버튼(오른쪽 아래는 맨 위로 버튼) → 아래에서 올라오는 시트. 항목을 누르면 닫고 그 제목으로 간다.
import type { MarkdownHeading } from "astro";
import Icon from "./Icon.astro";
import BottomSheet from "./BottomSheet.astro";
import { ui, type Lang } from "../i18n";

interface Props {
  headings: MarkdownHeading[];
  lang: Lang;
}

const { headings, lang } = Astro.props;
const t = ui[lang];
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
let section = 0;
---

{
  items.length > 0 && (
    <>
      <button
        type="button"
        data-sheet-open="toc-sheet"
        aria-label={t.tocOpen}
        class="fixed bottom-[calc(5rem+env(safe-area-inset-bottom,0px))] left-4 z-10 hidden h-12 items-center gap-2 rounded-2xl bg-card px-4 text-sm font-bold text-accent-bar shadow-lg ring-2 ring-background md:bottom-4 2xl:!hidden"
      >
        <Icon name="list" class="h-5 w-5" />
        {t.toc}
      </button>

      <BottomSheet id="toc-sheet" title={t.toc} lang={lang}>
        <nav aria-label={t.toc}>
          {items.map((h) => (
            <a href={`#${h.slug}`} data-sheet-dismiss class="flex min-h-11 items-center gap-2 rounded-xl px-2 py-2 text-sm text-muted-foreground hover:bg-[var(--toc-hover)]">
              {h.depth === 2 ? (
                <span class="flex h-5 w-5 flex-none items-center justify-center rounded-lg bg-[var(--toc-badge)] text-xs font-bold text-accent-bar">
                  {++section}
                </span>
              ) : (
                <span class="ml-4 flex h-5 w-5 flex-none items-center justify-center" aria-hidden="true">
                  <span class="h-2 w-2 rounded-[0.1875rem] bg-[var(--toc-badge)]" />
                </span>
              )}
              <span>{h.text}</span>
            </a>
          ))}
        </nav>
      </BottomSheet>
    </>
  )
}
