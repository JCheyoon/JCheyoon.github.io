---
import BaseLayout from "../layouts/BaseLayout.astro";
import ListHeader from "../components/ListHeader.astro";
import PostList from "../components/PostList.astro";
import Pagination from "../components/Pagination.astro";
import { site } from "../site.config";
import { getVisiblePosts, totalPages } from "../lib/posts";

const posts = await getVisiblePosts();
const pageCount = totalPages(posts.length, site.pageSize);
---

<BaseLayout title={site.name} description={site.description} isHome>
  <ListHeader title="전체 글" count={posts.length} />
  <PostList posts={posts.slice(0, site.pageSize)} />
  <Pagination current={1} total={pageCount} />
</BaseLayout>
