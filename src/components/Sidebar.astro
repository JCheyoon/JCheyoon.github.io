---
// 프로필과 카테고리. 글이 없는 카테고리는 페이지가 없으므로 목록에 넣지 않는다(죽은 링크 방지).
import { site } from "../site.config";
import { categories, categoryName, categoryUrl } from "../data/categories";
import { filterByCategory, type Post } from "../lib/posts";
import { localizePath, ui, type Lang } from "../i18n";

interface Props {
  posts: Post[];
  lang: Lang;
}

const { posts, lang } = Astro.props;
const t = ui[lang];
const path = Astro.url.pathname;
const home = localizePath(lang, "/");

const listed = categories
  .map((c) => ({ ...c, count: filterByCategory(posts, c.slug).length }))
  .filter((c) => c.count > 0);
---

<aside class="flex flex-col gap-6" aria-label={t.sidebar}>
  <section class="rounded-2xl border bg-card px-5 py-5 text-center">
    <p class="text-2xl font-bold tracking-wide">WELCOME</p>
    <p class="mt-1 text-sm font-semibold">{site.author.name}</p>
    <p class="mt-2 text-xs text-muted-foreground">{site.tagline[lang]}</p>
    <ul class="mt-4 flex justify-center gap-3">
      {
        site.social.map((s) => (
          <li>
            <a href={s.href} rel="me noopener" class="text-sm font-bold hover:underline">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    listed.length > 0 && (
      <nav class="rounded-2xl border bg-card px-3 py-4" aria-label={t.categories}>
        <h2 class="mb-3 px-2 text-base font-semibold text-muted-foreground">{t.categories}</h2>
        <ul class="flex flex-col gap-1">
          {/* 맨 위는 전체 글(= 홈 목록). 카테고리 페이지에서 전체로 돌아갈 수 있게 한다 */}
          {[
            { href: home, name: t.allPosts, count: posts.length, active: path === home || path.startsWith(localizePath(lang, "/page/")) },
            ...listed.map((c) => {
              const href = categoryUrl(c.slug, lang);
              return { href, name: categoryName(c, lang), count: c.count, active: path === href };
            }),
          ].map(({ href, name, count, active }) => {
            return (
              <li>
                <a
                  href={href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "flex items-center justify-between rounded-lg px-3 py-2 text-sm",
                    active
                      ? "bg-background font-semibold text-foreground"
                      : "text-muted-foreground hover:bg-background hover:text-foreground",
                  ]}
                >
                  <span>{name}</span>
                  <span class="text-xs">{count}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    )
  }
</aside>
