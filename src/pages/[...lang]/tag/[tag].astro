---
// 태그 글 목록(SPEC §4, D13). 한국어 /tag/<tag>/, 영어 /en/tag/<tag>/. 글이 있는 태그만 페이지를 만든다.
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ListHeader from "../../../components/ListHeader.astro";
import PostList from "../../../components/PostList.astro";
import { site } from "../../../site.config";
import { getVisiblePosts, tagCounts, tagUrl } from "../../../lib/posts";
import { langPaths, localizePath, otherLang, ui } from "../../../i18n";

export const getStaticPaths = (async () => {
  const perLang = await Promise.all(
    langPaths.map(async ({ params, props: { lang } }) => {
      const posts = await getVisiblePosts(lang);
      // 다른 언어에도 이 태그 글이 있으면 그 태그 페이지가 짝이다
      const other = otherLang(lang);
      const otherTags = new Set(tagCounts(await getVisiblePosts(other)).map((t) => t.tag));
      return tagCounts(posts).map(({ tag }) => ({
        params: { ...params, tag },
        props: {
          lang,
          tag,
          posts: posts.filter((p) => p.data.tags.includes(tag)),
          alternate: otherTags.has(tag) ? tagUrl(tag, other) : undefined,
        },
      }));
    }),
  );
  return perLang.flat();
}) satisfies GetStaticPaths;

const { lang, tag, posts, alternate } = Astro.props;
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: site.name, item: new URL(localizePath(lang, "/"), site.url).href },
    { "@type": "ListItem", position: 2, name: `#${tag}`, item: new URL(Astro.url.pathname, site.url).href },
  ],
};
---

<BaseLayout
  title={`#${tag}`}
  description={ui[lang].tagDescription(site.name, tag, posts.length)}
  jsonLd={[breadcrumb]}
  lang={lang}
  alternate={alternate}
>
  <ListHeader title={`#${tag}`} count={posts.length} lang={lang} />
  <PostList posts={posts} lang={lang} />
</BaseLayout>
