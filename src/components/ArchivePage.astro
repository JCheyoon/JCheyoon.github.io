---
// 아카이브(SPEC §4, §6): 연도별로 묶은 전체 글. pages/archive.astro(한국어)와 pages/en/archive.astro(영어)가 쓴다.
// [...lang] 라우트에 두면 /archive/가 [...lang] 홈 라우트(lang="archive")와 겹쳐 빌드가 실패한다(2026-11-25 확인).
// 왼쪽부터 날짜(월·일) → 점선 타임라인의 점 → 제목 → 태그.
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site.config";
import { formatMonthDay, getVisiblePosts, isoDate, postDate, postUrl, yearOf } from "../lib/posts";
import { localizePath, otherLang, ui, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const posts = await getVisiblePosts(lang);

const groups = [...Map.groupBy(posts, (p) => yearOf(postDate(p)))].sort(([a], [b]) => b - a);
---

<BaseLayout
  title={t.archive}
  description={t.archiveDescription(site.name, posts.length)}
  lang={lang}
  alternate={localizePath(otherLang(lang), "/archive/")}
>
  <section class="rounded-2xl border bg-card px-4 py-6 md:px-8">
    <h1 class="sr-only">{t.archive}</h1>
    {posts.length === 0 && <p class="py-4 text-center text-sm text-muted-foreground">{t.noPosts}</p>}
    {
      groups.map(([year, list]) => (
        <div>
          <div class="flex h-15 items-center">
            <p class="w-[18%] text-right text-2xl font-bold md:w-[12%]">{year}</p>
            <div class="flex w-[12%] justify-center md:w-[8%]">
              <span class="h-3 w-3 rounded-full border-[3px] border-accent-bar" aria-hidden="true" />
            </div>
            <p class="text-sm text-muted-foreground">{t.postCount(list.length)}</p>
          </div>
          <ul>
            {list.map((post) => (
              <li>
                <a href={postUrl(post)} class="group flex h-10 items-center rounded-lg transition hover:bg-background">
                  <time datetime={isoDate(postDate(post))} class="w-[18%] text-right text-sm text-muted-foreground md:w-[12%]">
                    {formatMonthDay(postDate(post))}
                  </time>
                  <span class="archive-line relative flex h-full w-[12%] items-center justify-center md:w-[8%]" aria-hidden="true">
                    <span class="z-10 h-1 w-1 rounded bg-muted-foreground outline-4 outline-card transition-all group-hover:h-5 group-hover:bg-accent-bar group-hover:outline-background" />
                  </span>
                  <span class="min-w-0 flex-1 truncate pr-4 font-bold transition group-hover:translate-x-1 group-hover:text-accent-bar">
                    {post.data.title}
                  </span>
                  <span class="hidden w-[20%] truncate text-sm text-muted-foreground md:block">
                    {post.data.tags.map((tag) => `#${tag}`).join(" ")}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</BaseLayout>

<style>
  /* 날짜와 제목 사이의 세로 점선 타임라인 */
  .archive-line::before {
    content: "";
    position: absolute;
    inset-block: 0;
    left: 50%;
    border-left: 2px dashed var(--border);
  }
</style>
