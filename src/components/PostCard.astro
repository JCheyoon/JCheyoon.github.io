---
import { getCategory } from "../data/categories";
import { formatDate, isoDate, postDate, postUrl, type Post } from "../lib/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const category = getCategory(post.data.category);
const date = postDate(post);
---

<article class="rounded-2xl border bg-card px-6 py-5 transition hover:shadow-lg">
  <div class="relative pl-5">
    <span class="absolute left-0 top-1.5 h-4 w-1 rounded-full bg-accent-bar" aria-hidden="true"></span>
    <h2 class="text-lg font-bold leading-snug">
      <a href={postUrl(post)} class="hover:underline">{post.data.title}</a>
    </h2>
    <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted-foreground">
      <time datetime={isoDate(date)}>{formatDate(date)}</time>
      {category && <a href={`/category/${category.slug}/`} class="hover:text-foreground">{category.name}</a>}
      {post.data.status !== "published" && <span class="rounded bg-secondary px-2 py-0.5">초안: {post.data.status}</span>}
    </div>
    <p class="mt-3 line-clamp-2 text-sm text-muted-foreground">{post.data.description}</p>
  </div>
</article>
