---
// 모바일 목록 필터(SPEC §6.2, D15). 768px 미만에서는 사이드바를 숨기고 목록 위에 두 버튼을 둔다.
// [📁 카테고리 ▾] [# 태그 ▾]: 누르면 각각 바텀 시트. 버튼 이름에 지금 고른 카테고리·태그를 보인다.
// 고른 태그는 시트 맨 위 "선택 해제"나 같은 태그를 다시 눌러 해제한다(사이드바와 같은 동작).
// 스크립트가 없으면 시트를 열 수 없으므로 카테고리 링크 줄을 대신 보인다.
import Icon from "./Icon.astro";
import BottomSheet from "./BottomSheet.astro";
import { type Post } from "../lib/posts";
import { categoryItems, tagItems } from "../lib/filters";
import { localizePath, ui, type Lang } from "../i18n";

interface Props {
  posts: Post[];
  lang: Lang;
}

const { posts, lang } = Astro.props;
const t = ui[lang];
const path = Astro.url.pathname;
const home = localizePath(lang, "/");
const categoryList = categoryItems(posts, lang, path);
const tags = tagItems(posts, lang, path);
const activeCategory = categoryList.find((c) => c.active);
const activeTag = tags.find((tag) => tag.active)?.tag;
// "전체 글"이 아닌 카테고리를 골랐을 때만 버튼을 강조한다
const categoryChosen = activeCategory !== undefined && activeCategory.href !== home;
// 태그 페이지처럼 카테고리 항목이 하나도 활성이 아니면 "전체 글"이라고 하지 않고 중립 이름을 보인다
const categoryLabel = activeCategory?.name ?? t.categories;
const filterButton = "hidden h-11 min-w-0 flex-1 items-center gap-2 rounded-xl bg-card px-4 text-sm";
---

{
  posts.length > 0 && (
    <div class="mb-2.5 md:hidden">
      <div class="flex gap-2">
        <button
          type="button"
          data-sheet-open="category-sheet"
          aria-label={`${t.categories}: ${categoryLabel}`}
          class:list={[filterButton, categoryChosen ? "font-semibold text-accent-text" : "text-foreground"]}
        >
          <Icon name="folder" class="h-4 w-4 flex-none" />
          <span class="truncate">{categoryLabel}</span>
          <Icon name="chevron-down" class="ml-auto h-4 w-4 flex-none" />
        </button>
        {tags.length > 0 && (
          <button
            type="button"
            data-sheet-open="tag-sheet"
            aria-label={activeTag ? `${t.tags}: ${activeTag}` : t.tags}
            class:list={[filterButton, activeTag ? "font-semibold text-accent-text" : "text-foreground"]}
          >
            <Icon name="tag" class="h-4 w-4 flex-none" />
            <span class="truncate">{activeTag ?? t.tags}</span>
            <Icon name="chevron-down" class="ml-auto h-4 w-4 flex-none" />
          </button>
        )}
      </div>

      {/* 스크립트가 없을 때만: 카테고리 링크 줄. 오른쪽 끝을 흐리게 해서 옆으로 더 넘길 수 있음을 보인다 */}
      <nav aria-label={t.categories} class="no-js-only">
        <ul class="no-scrollbar -mx-4 flex gap-2 overflow-x-auto px-4 pr-12 [mask-image:linear-gradient(to_right,black_calc(100%-2.5rem),transparent)]">
          {categoryList.map((c) => (
            <li>
              <a
                href={c.href}
                aria-current={c.active ? "page" : undefined}
                class:list={["flex h-9 items-center rounded-lg px-3 text-sm whitespace-nowrap", c.active ? "bg-card font-semibold" : "bg-card/60 text-muted-foreground"]}
              >
                {c.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <BottomSheet id="category-sheet" title={t.categories} lang={lang}>
        <ul class="flex flex-col gap-1">
          {categoryList.map((c) => (
            <li>
              <a
                href={c.href}
                data-sheet-dismiss
                aria-current={c.active ? "page" : undefined}
                class:list={["flex h-11 items-center justify-between rounded-xl px-4 text-sm", c.active ? "bg-logo font-semibold text-on-logo" : "hover:bg-background"]}
              >
                <span>{c.name}</span>
                <span class:list={["text-xs", c.active ? "opacity-80" : "text-muted-foreground"]}>{c.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </BottomSheet>

      {tags.length > 0 && (
        <BottomSheet id="tag-sheet" title={t.tags} lang={lang}>
          {activeTag && (
            <a href={home} data-sheet-dismiss class="mb-3 flex h-11 items-center justify-center gap-2 rounded-xl bg-background text-sm font-semibold">
              <Icon name="close" class="h-4 w-4" />
              {t.tagClear(activeTag)}
            </a>
          )}
          <ul class="flex flex-wrap gap-2">
            {tags.map(({ tag, count, active, href }) => (
              // 고른 태그 링크는 해제 동작이라 aria-current 대신 이름에 선택 상태를 담는다(사이드바와 같다)
              <li>
                <a
                  href={href}
                  data-sheet-dismiss
                  aria-label={active ? t.tagSelected(tag) : undefined}
                  class:list={["flex h-11 items-center gap-1.5 rounded-xl px-4 text-sm", active ? "bg-logo font-semibold text-on-logo" : "bg-background text-foreground"]}
                >
                  #{tag}
                  <span class:list={["text-xs", active ? "opacity-80" : "text-muted-foreground"]}>{count}</span>
                </a>
              </li>
            ))}
          </ul>
        </BottomSheet>
      )}
    </div>
  )
}

<style>
  :global(.js) .no-js-only {
    display: none;
  }
  /* 넘기는 기능은 두고 스크롤 막대만 숨긴다. 넘길 수 있다는 표시는 오른쪽 끝 흐림이 맡는다 */
  .no-scrollbar {
    scrollbar-width: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>
