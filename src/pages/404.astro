---
// GitHub Pages는 없는 경로에 이 페이지(404.html)를 404 상태로 돌려준다.
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="페이지를 찾을 수 없습니다" description="요청한 페이지가 없습니다." noindex sidebar={false}>
  <section class="mx-auto max-w-xl py-16 text-center">
    <p class="text-5xl font-bold text-accent-text">404</p>
    <h1 class="mt-4 text-2xl font-bold">페이지를 찾을 수 없습니다</h1>
    <p class="mt-3 text-muted-foreground">주소가 바뀌었거나 없는 페이지입니다.</p>
    <p class="mt-8">
      <a href="/" class="rounded-full bg-primary px-5 py-3 text-sm font-medium text-primary-foreground">홈으로 가기</a>
    </p>
  </section>
</BaseLayout>
