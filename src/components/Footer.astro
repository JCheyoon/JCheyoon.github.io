---
// 푸터(SPEC §6): 문의·개인정보 처리방침·이용약관 링크와 저작권. 링크는 지금 언어의 페이지로 간다.
// 768px 미만에서는 GitHub 링크도 보인다.
import { site } from "../site.config";
import { localizePath, ui, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
const links = [
  { href: localizePath(lang, "/contact/"), label: t.contact },
  { href: localizePath(lang, "/privacy/"), label: t.privacy },
  { href: localizePath(lang, "/terms/"), label: t.terms },
];
---

{/* 아래 여백: 1536px 미만은 화면 아래에 떠 있는 목차·맨 위로 버튼(높이 48px + 간격 16px)이 푸터 글을 가리지 않게 넓힌다 */}
<footer class="mt-12 border-t bg-background pt-10 pb-20 text-sm text-muted-foreground 2xl:pb-10">
  <nav aria-label={t.footerMenu} class="mb-3">
    <ul class="flex flex-wrap justify-center gap-x-5 gap-y-2">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="hover:text-foreground hover:underline">
              {link.label}
            </a>
          </li>
        ))
      }
      {/* 768px 미만은 사이드바(GitHub 링크가 있는 곳)를 숨기므로 푸터에서 보여 준다 */}
      {
        site.social.map((s) => (
          <li class="md:hidden">
            <a href={s.href} target="_blank" rel="me noopener" class="hover:text-foreground hover:underline">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <p class="text-center">
    © {year} <span class="font-semibold text-foreground">{site.author.name}</span>. All Rights Reserved.
  </p>
</footer>
