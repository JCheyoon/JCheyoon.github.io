---
// 목차 바텀 시트(SPEC §6.2, D15). 오른쪽 목차가 숨는 화면(1536px 미만)에서 쓴다.
// 왼쪽 아래 "목차" 버튼 → 아래에서 올라오는 시트. 브라우저 기본 <dialog>를 써서 Esc·포커스 이동을 맡긴다.
// 스크립트가 없으면 버튼을 숨긴다(.js에서만 보임).
import type { MarkdownHeading } from "astro";
import Icon from "./Icon.astro";
import { ui, type Lang } from "../i18n";

interface Props {
  headings: MarkdownHeading[];
  lang: Lang;
}

const { headings, lang } = Astro.props;
const t = ui[lang];
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
let section = 0;
---

{
  items.length > 0 && (
    <>
      <button
        type="button"
        data-toc-sheet-open
        aria-label={t.tocOpen}
        class="toc-sheet-button fixed bottom-20 left-4 z-10 hidden h-12 items-center gap-2 rounded-2xl bg-card px-4 text-sm font-bold text-accent-bar shadow-lg ring-2 ring-background md:bottom-4 2xl:!hidden"
      >
        <Icon name="list" class="h-5 w-5" />
        {t.toc}
      </button>

      <dialog data-toc-sheet aria-label={t.toc} class="toc-sheet">
        <div class="mx-auto mb-3 h-1 w-10 rounded-full bg-border" aria-hidden="true" />
        <div class="mb-2 flex items-center justify-between">
          <p class="font-bold">{t.toc}</p>
          <button type="button" data-toc-sheet-close aria-label={t.close} class="flex h-9 w-9 items-center justify-center rounded-lg text-muted-foreground hover:bg-background">
            <Icon name="close" class="h-5 w-5" />
          </button>
        </div>
        <nav aria-label={t.toc} class="max-h-[60vh] overflow-y-auto">
          {items.map((h) => (
            <a href={`#${h.slug}`} data-toc-sheet-link class="flex min-h-9 gap-2 rounded-xl px-2 py-2 text-sm text-muted-foreground hover:bg-[var(--toc-hover)]">
              {h.depth === 2 ? (
                <span class="flex h-5 w-5 flex-none items-center justify-center rounded-lg bg-[var(--toc-badge)] text-xs font-bold text-accent-bar">
                  {++section}
                </span>
              ) : (
                <span class="ml-4 flex h-5 w-5 flex-none items-center justify-center" aria-hidden="true">
                  <span class="h-2 w-2 rounded-[0.1875rem] bg-[var(--toc-badge)]" />
                </span>
              )}
              <span>{h.text}</span>
            </a>
          ))}
        </nav>
      </dialog>
    </>
  )
}

<style>
  :global(.js) .toc-sheet-button {
    display: flex;
  }
  .toc-sheet {
    width: 100%;
    max-width: 40rem;
    margin: auto auto 0;
    padding: 0.75rem 1rem calc(1.5rem + env(safe-area-inset-bottom, 0px));
    border: 0;
    border-radius: 1.25rem 1.25rem 0 0;
    background: var(--card);
    color: var(--foreground);
  }
  /* ::backdrop은 오래된 브라우저에서 :root 변수를 물려받지 못해 같은 값을 대체값으로 둔다 */
  .toc-sheet::backdrop {
    background: var(--scrim, oklch(0 0 0 / 45%));
  }
  @media (prefers-reduced-motion: no-preference) {
    .toc-sheet[open] {
      animation: toc-sheet-up 0.2s ease-out;
    }
  }
  @keyframes toc-sheet-up {
    from {
      transform: translateY(100%);
    }
  }
</style>

<script>
  const sheet = document.querySelector<HTMLDialogElement>("[data-toc-sheet]");
  document.querySelector("[data-toc-sheet-open]")?.addEventListener("click", () => sheet?.showModal());
  document.querySelector("[data-toc-sheet-close]")?.addEventListener("click", () => sheet?.close());
  // 바깥(어두운 배경)을 누르면 닫는다
  sheet?.addEventListener("click", (e) => {
    if (e.target === sheet) sheet.close();
  });
  // 목차 항목을 누르면 닫고 그 제목으로 이동한다
  sheet?.querySelectorAll("[data-toc-sheet-link]").forEach((a) => a.addEventListener("click", () => sheet.close()));
</script>
