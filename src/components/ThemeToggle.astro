---
// 테마 토글(D14, SPEC §8). 라이트/다크 2단계. 처음엔 시스템 설정을 따르고, 누르면 반대로 바꿔 저장한다.
// 스크립트가 없으면 시스템 설정을 따르고 버튼은 숨긴다(동작하지 않는 UI를 두지 않는다).
import Icon from "./Icon.astro";
import { ui, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label={ui[lang].themeToggle}
  aria-pressed="false"
  class="theme-toggle hidden h-10 w-10 items-center justify-center rounded-lg text-muted-foreground transition hover:bg-background hover:text-foreground"
>
  {/* 아이콘은 하나만 보인다. 지금 라이트면 달(누르면 다크), 다크면 해(누르면 라이트) */}
  <span class="theme-icon-moon"><Icon name="moon" class="h-5 w-5" /></span>
  <span class="theme-icon-sun"><Icon name="sun" class="h-5 w-5" /></span>
</button>

<style>
  :global(.js) .theme-toggle {
    display: flex;
  }
  /* 지금 테마는 data-theme(고른 경우) 또는 시스템 설정(고르지 않은 경우)이다 */
  :global([data-theme="dark"]) .theme-icon-moon,
  :global([data-theme="light"]) .theme-icon-sun {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .theme-icon-moon {
      display: none;
    }
  }
  @media not (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .theme-icon-sun {
      display: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const dark = matchMedia("(prefers-color-scheme: dark)");
  const current = () => root.dataset.theme ?? (dark.matches ? "dark" : "light");
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");
  // 보조 기술에 지금 테마를 알린다(다크면 눌린 상태)
  const sync = () => buttons.forEach((b) => b.setAttribute("aria-pressed", String(current() === "dark")));
  dark.addEventListener("change", sync);
  sync();
  for (const button of buttons) {
    button.addEventListener("click", () => {
      const next = current() === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      sync();
      try {
        localStorage.setItem("theme", next);
      } catch {}
    });
  }
</script>
