---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../site.config";
import { isListPage } from "../lib/posts";
import { localizePath, otherLang, ui, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  /** 언어 전환 링크 주소. 없으면 링크를 그리지 않는다. */
  switchHref?: string;
  /** 768px 미만 글 페이지: 로고 대신 왼쪽 뒤로(‹) 링크를 보인다. label은 화면 읽기용(SPEC §6.2) */
  mobileBack?: { href: string; label: string };
  /** 검색할 글이 있을 때만 검색 버튼을 그린다(BaseLayout) */
  searchable: boolean;
}

const { lang, switchHref, mobileBack, searchable } = Astro.props;
const target = ui[otherLang(lang)];
const t = ui[lang];
const home = localizePath(lang, "/");

// 문의는 Phase 4에서 추가한다(미구현 메뉴는 두지 않는다).
const links = [
  { href: home, label: t.home },
  { href: localizePath(lang, "/archive/"), label: t.archive },
  { href: localizePath(lang, "/about/"), label: t.about },
];

const path = Astro.url.pathname;
const isActive = (href: string) => (href === home ? isListPage(path, lang) : path.startsWith(href));
---

{/*
  막대 없는 헤더(SPEC §6.1). 흰 배경·테두리 없이 페이지 배경 위에 로고와 아이콘만 둔다.
  맨 위에서는 투명하고, 조금 내리면 옅은 배경과 흐림이 생겨 아래로 지나가는 글 위에서도 읽힌다(data-scrolled).
  스크립트가 없으면 처음부터 흐림 배경을 둔다.
  - 768px 미만: 높이 48px, 왼쪽 로고(글 페이지는 뒤로 ‹), 오른쪽 언어·테마. 메뉴는 하단 탭 바. 내리면 숨는다
  - 768px 이상: 높이 64px, 본문과 같은 칸(사이드바 17rem | 본문)에 맞춘다. 로고는 사이드바 왼쪽 선, 도구는 본문 오른쪽 선
*/}
<header class="site-header sticky top-0 z-10">
  <div class="mx-auto flex h-12 max-w-[1200px] items-center justify-between gap-2 px-4 md:grid md:h-16 md:grid-cols-[17rem_minmax(0,1fr)_auto] md:gap-6 md:px-6">
    <a
      href={home}
      class:list={["items-center justify-self-start text-foreground", mobileBack ? "hidden md:flex" : "flex"]}
      aria-label={`${site.name} ${t.home}`}
    >
      <Logo />
    </a>
    {
      mobileBack && (
        <a href={mobileBack.href} class="-ml-2 flex h-10 w-10 items-center justify-center rounded-full text-foreground md:hidden" aria-label={`${t.back}: ${mobileBack.label}`}>
          <Icon name="chevron-left" class="h-6 w-6" />
        </a>
      )
    }
    {/*
      알약 묶음 메뉴: 세 메뉴를 반투명 카드색 둥근 묶음 하나에 넣어 "메뉴"로 보이게 한다.
      현재 메뉴는 안쪽 옅은 청록 알약, 마우스를 올리면 더 옅은 알약(오른쪽 아이콘 버튼과 같은 hover)
    */}
    <nav aria-label={t.mainMenu} class="hidden justify-self-center md:block">
      <ul class="flex items-center gap-0.5 rounded-full bg-card/70 p-1 shadow-sm ring-1 ring-border">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? (path === link.href ? "page" : "true") : undefined}
                class:list={[
                  "inline-flex h-9 items-center rounded-full px-4 text-sm font-bold transition",
                  isActive(link.href)
                    ? "bg-[var(--toc-active)] text-foreground"
                    : "text-muted-foreground hover:bg-[var(--toc-hover)] hover:text-foreground",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {/* 오른쪽 도구: 테두리 없는 둥근 아이콘 버튼. 검색(768px 이상, 모바일은 하단 탭) + 언어(번역본이 있을 때) + 테마 */}
    <div class="flex items-center gap-1 justify-self-end">
      {
        searchable && (
          <button
            type="button"
            data-search-open
            aria-label={`${t.search} (⌘K)`}
            title={`${t.search} ⌘K`}
            class="hidden h-10 w-10 items-center justify-center rounded-full text-muted-foreground transition hover:bg-[var(--toc-hover)] hover:text-foreground max-md:!hidden"
          >
            <Icon name="search" class="h-5 w-5" />
          </button>
        )
      }
      {
        switchHref && (
          <a
            href={switchHref}
            hreflang={target.htmlLang}
            lang={target.htmlLang}
            aria-label={target.langSwitch}
            class="inline-flex h-10 items-center rounded-full px-3 text-sm font-semibold text-muted-foreground transition hover:bg-[var(--toc-hover)] hover:text-foreground"
          >
            <span class="lg:hidden">{target.langShort}</span>
            <span class="hidden lg:inline">{target.langName}</span>
          </a>
        )
      }
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>

<script>
  // data-scrolled: 조금 내리면 흐림 배경. data-hidden: 아래로 내리면 숨김(768px 미만에서만 적용, global.css)
  const header = document.querySelector<HTMLElement>(".site-header");
  let last = scrollY;
  const update = () => {
    const y = scrollY;
    header?.toggleAttribute("data-scrolled", y > 8);
    header?.toggleAttribute("data-hidden", y > last && y > 64);
    last = y;
  };
  addEventListener("scroll", update, { passive: true });
  update();
</script>
