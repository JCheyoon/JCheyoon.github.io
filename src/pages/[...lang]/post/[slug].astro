---
// 글 페이지(SPEC §6, §7). 한국어는 /post/<slug>/, 영어는 /en/post/<slug>/.
// 본문은 빌드 HTML에 들어가고, BlogPosting·BreadcrumbList JSON-LD를 넣는다.
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Icon from "../../../components/Icon.astro";
import Toc from "../../../components/Toc.astro";
import TocSheet from "../../../components/TocSheet.astro";
import Comments from "../../../components/Comments.astro";
import { site } from "../../../site.config";
import { categoryName, categoryUrl, getCategory } from "../../../data/categories";
import { formatDate, getVisiblePosts, isoDate, ogImageUrl, postDate, postUrl, tagUrl, type Post } from "../../../lib/posts";
import { langPaths, localizePath, otherLang, ui } from "../../../i18n";

export const getStaticPaths = (async () => {
  const perLang = await Promise.all(
    langPaths.map(async ({ params, props: { lang } }) => {
      const posts = await getVisiblePosts(lang);
      // 원문과 번역본은 같은 slug를 쓴다. 다른 언어에 공개된 같은 slug의 글이 짝이다(SPEC §9.2).
      const otherPosts = await getVisiblePosts(otherLang(lang));
      // posts는 최신순이다. newer = 바로 다음에 나온 글, older = 바로 앞에 나온 글. 같은 언어 안에서만 잇는다.
      return posts.map((post, i) => ({
        params: { ...params, slug: post.data.slug },
        props: {
          post,
          newer: posts[i - 1],
          older: posts[i + 1],
          translation: otherPosts.find((p) => p.data.slug === post.data.slug),
        },
      }));
    }),
  );
  return perLang.flat();
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
  translation?: Post;
}

const { post, newer, older, translation } = Astro.props;
const { data } = post;
const lang = data.lang;
const t = ui[lang];
const { Content, headings } = await render(post);

const category = getCategory(data.category);
const published = postDate(post);
const isDraft = data.status !== "published";
const pageUrl = new URL(postUrl(post), site.url).href;
const ogImage = ogImageUrl(post);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: data.title,
    description: data.description,
    datePublished: published.toISOString(),
    dateModified: (data.updated_at ?? published).toISOString(),
    author: { "@type": "Person", name: site.author.name },
    image: new URL(ogImage, site.url).href,
    mainEntityOfPage: pageUrl,
    inLanguage: lang,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: site.name, item: new URL(localizePath(lang, "/"), site.url).href },
      ...(category
        ? [{ "@type": "ListItem", position: 2, name: categoryName(category, lang), item: new URL(categoryUrl(category.slug, lang), site.url).href }]
        : []),
      { "@type": "ListItem", position: category ? 3 : 2, name: data.title, item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  image={ogImage}
  publishedTime={published}
  modifiedTime={data.updated_at}
  noindex={isDraft}
  jsonLd={jsonLd}
  lang={lang}
  alternate={translation ? postUrl(translation) : null}
  mobileBack={category ? { href: categoryUrl(category.slug, lang), label: categoryName(category, lang) } : { href: localizePath(lang, "/"), label: t.home }}
>
  <Toc slot="toc" headings={headings} lang={lang} />
  <TocSheet headings={headings} lang={lang} />

  {/* 글 전체를 흰 카드 하나에 담는다(SPEC §6.1). 이전·다음 글은 카드 밖에 따로 둔다 */}
  {/* data-pagefind-*: 검색 색인(D16)은 글 본문만 담는다. 이동 경로·메타·태그는 색인에서 뺀다 */}
  <article class="rounded-2xl border bg-card px-6 pt-6 pb-8 md:px-9" data-pagefind-body>
    {
      isDraft && (
        <p class="mb-6 rounded-xl border border-dashed px-4 py-3 text-sm text-muted-foreground">
          {t.draftNotice(data.status)}
        </p>
      )
    }

    <header>
      {/* 작은 이동 경로. BreadcrumbList 구조화 데이터와 같은 내용을 화면에도 보여 준다(SPEC §7) */}
      <nav aria-label={t.breadcrumb} class="mb-3 text-xs text-muted-foreground" data-pagefind-ignore>
        <a href={localizePath(lang, "/")} class="hover:text-accent-bar">{t.home}</a>
        {
          category && (
            <>
              <span aria-hidden="true"> › </span>
              <a href={categoryUrl(category.slug, lang)} class="hover:text-accent-bar">
                {categoryName(category, lang)}
              </a>
            </>
          )
        }
      </nav>
      <h1
        data-pagefind-meta="title"
        class="relative mb-3 text-3xl font-bold leading-tight md:text-[2.25rem] md:leading-[2.75rem] md:before:absolute md:before:top-3 md:before:-left-[1.125rem] md:before:h-5 md:before:w-1 md:before:rounded-full md:before:bg-accent-bar"
      >
        {data.title}
      </h1>
      <ul class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-medium text-muted-foreground" data-pagefind-ignore>
        <li class="flex items-center gap-2">
          <span class="meta-icon"><Icon name="calendar" class="h-5 w-5" /></span>
          <time datetime={isoDate(published)}>{formatDate(published, lang)}</time>
        </li>
        {
          data.updated_at && (
            <li class="flex items-center gap-2">
              <span class="meta-icon"><Icon name="edit" class="h-5 w-5" /></span>
              <span class="sr-only">{t.updated}</span>
              <time datetime={isoDate(data.updated_at)}>{formatDate(data.updated_at, lang)}</time>
            </li>
          )
        }
        {
          category && (
            <li class="flex items-center gap-2">
              <span class="meta-icon"><Icon name="folder" class="h-5 w-5" /></span>
              <a href={categoryUrl(category.slug, lang)} class="hover:text-accent-bar">
                {categoryName(category, lang)}
              </a>
            </li>
          )
        }
        <li class="flex items-center gap-2">
          <span class="meta-icon"><Icon name="user" class="h-5 w-5" /></span>
          {site.author.name}
        </li>
      </ul>
    </header>

    {/* 번역본 안내(SPEC §9.2): AI가 번역하고 작성자가 검수한 글이라고 알린다. 원문으로 가는 링크를 함께 둔다 */}
    {
      data.translated_from && data.ai_assisted && (
        <p class="mt-5 rounded-xl border px-4 py-3 text-sm text-muted-foreground" role="note" data-pagefind-ignore>
          {t.translatedNote(data.translated_from)}
          {translation && (
            <>
              {" "}
              <a href={postUrl(translation)} hreflang={ui[data.translated_from].htmlLang} class="underline underline-offset-4">
                {t.readOriginal}
              </a>
            </>
          )}
        </p>
      )
    }

    {
      data.disclosure && (
        <p class="mt-5 rounded-xl border-2 border-accent-bar px-4 py-3 text-sm font-semibold" role="note">
          {data.disclosure}
        </p>
      )
    }

    {
      data.cover ? (
        <Image src={data.cover.src} alt={data.cover.alt} class="mt-6 mb-8 w-full rounded-xl" loading="eager" />
      ) : (
        <hr class="my-5 border-dashed" />
      )
    }

    <div class="post-body prose prose-slate max-w-none dark:prose-invert">
      <Content />
    </div>

    {
      data.sources.length > 0 && (
        <section class="mt-10" aria-labelledby="sources-heading" data-pagefind-ignore>
          <h2 id="sources-heading" class="text-lg font-semibold">
            {t.sources}
          </h2>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-sm">
            {data.sources.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener" class="underline underline-offset-4">
                  {s.title}
                </a>
                <span class="text-muted-foreground"> ({t.accessed(formatDate(s.accessed, lang))})</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      data.tags.length > 0 && (
        <ul class="mt-8 flex flex-wrap gap-2" aria-label={t.tags} data-pagefind-ignore>
          {data.tags.map((tag) => (
            <li>
              <a href={tagUrl(tag, lang)} class="block rounded-lg bg-background px-3 py-1 text-sm text-muted-foreground transition hover:text-accent-bar">
                #{tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </article>

  {
    (newer || older) && (
      <nav aria-label={t.prevNextNav} class="mt-4 grid gap-4 font-bold sm:grid-cols-2">
        {older ? (
          <a
            href={postUrl(older)}
            rel="prev"
            aria-label={`${t.prevPost}: ${older.data.title}`}
            class="flex h-15 items-center gap-4 rounded-2xl bg-card px-4 transition hover:bg-muted active:scale-95"
          >
            <Icon name="chevron-left" class="h-7 w-7 flex-none text-accent-bar" />
            <span class="truncate">{older.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {newer && (
          <a
            href={postUrl(newer)}
            rel="next"
            aria-label={`${t.nextPost}: ${newer.data.title}`}
            class="flex h-15 items-center justify-end gap-4 rounded-2xl bg-card px-4 transition hover:bg-muted active:scale-95"
          >
            <span class="truncate">{newer.data.title}</span>
            <Icon name="chevron-right" class="h-7 w-7 flex-none text-accent-bar" />
          </a>
        )}
      </nav>
    )
  }

  {/* 댓글(D17)은 발행한 글에만 둔다. 초안 미리보기에서 쓴 댓글이 실제 Discussion이 되지 않게 한다 */}
  {!isDraft && <Comments slug={data.slug} lang={lang} />}
</BaseLayout>
